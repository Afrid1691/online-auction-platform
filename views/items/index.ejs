<%- include('../partials/header') %>

<h1>Live auctions</h1>

<form class="filters" method="GET" action="/items">
  <input type="search" name="q" placeholder="Search listings…" value="<%= q %>" />
  <select name="category">
    <option value="">All categories</option>
    <% categories.forEach(function (c) { %>
      <option value="<%= c %>" <%= c === activeCategory ? 'selected' : '' %>><%= c %></option>
    <% }) %>
  </select>
  <button type="submit">Filter</button>
</form>

<% if (!items.length) { %>
  <p>No listings match. Try a different search, or <a href="/items/new">list the first item</a>.</p>
<% } %>

<section class="grid">
  <% items.forEach(function (item) { %>
    <article class="card">
      <% if (item.imageUrl) { %>
        <img src="<%= item.imageUrl %>" alt="<%= item.title %>" class="card-img" />
      <% } %>
      <div class="card-body">
        <h2><a href="/items/<%= item._id %>"><%= item.title %></a></h2>
        <p class="muted"><%= item.category %> · Sold by <%= item.seller ? item.seller.name : 'Unknown' %></p>
        <p class="price">$<%= item.currentPrice.toFixed(2) %></p>
        <p class="muted countdown" data-ends-at="<%= new Date(item.endsAt).toISOString() %>">
          Ends <%= new Date(item.endsAt).toLocaleString() %>
        </p>
      </div>
    </article>
  <% }) %>
</section>

<%- include('../partials/footer') %>
